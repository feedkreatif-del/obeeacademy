rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == "feedkreatif@gmail.com" && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isValidSessionState(data) {
      return data.keys().hasAll([
        'activeQuestion',
        'activeSlide',
        'activeMode',
        'activePollId',
        'moderationEnabled',
        'externalEmbedUrl',
        'externalPlatform',
        'sessionName',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'activeQuestion',
        'activeSlide',
        'activeSlideStep',
        'stepByStepEnabled',
        'transitionStyle',
        'activeSlideDrawer',
        'allowParticipantSlideAccess',
        'answersLocked',
        'lockedNotice',
        'activeMode',
        'activePollId',
        'moderationEnabled',
        'externalEmbedUrl',
        'externalPlatform',
        'sessionName',
        'updatedAt'
      ]) &&
      data.activeQuestion is int && data.activeQuestion >= 0 && data.activeQuestion <= 30 &&
      data.activeSlide is int && data.activeSlide >= 0 && data.activeSlide <= 50 &&
      (!('activeSlideStep' in data) || (data.activeSlideStep is int && data.activeSlideStep >= 0 && data.activeSlideStep <= 30)) &&
      (!('stepByStepEnabled' in data) || data.stepByStepEnabled is bool) &&
      (!('transitionStyle' in data) || (data.transitionStyle is string && data.transitionStyle in ['slide', 'zoom', 'fade'])) &&
      (!('activeSlideDrawer' in data) || (data.activeSlideDrawer is string && data.activeSlideDrawer in ['none', 'answers', 'poll', 'qna', 'qr'])) &&
      (!('allowParticipantSlideAccess' in data) || data.allowParticipantSlideAccess is bool) &&
      (!('answersLocked' in data) || data.answersLocked is bool) &&
      (!('lockedNotice' in data) || (data.lockedNotice is string && data.lockedNotice.size() <= 200)) &&
      data.activeMode is string && data.activeMode in ['worksheet', 'poll', 'qna', 'external'] &&
      data.activePollId is string && data.activePollId.size() <= 64 &&
      data.moderationEnabled is bool &&
      data.externalEmbedUrl is string && data.externalEmbedUrl.size() <= 500 &&
      data.externalPlatform is string && data.externalPlatform in ['slido', 'mentimeter', 'custom'] &&
      data.sessionName is string && data.sessionName.size() <= 120 &&
      data.updatedAt is int;
    }

    function isValidCustomContent(data) {
      return data.keys().hasAll([
        'seminarTitle',
        'organizerName',
        'questions',
        'polls',
        'slides',
        'qnaTopics',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'seminarTitle',
        'organizerName',
        'questions',
        'polls',
        'slides',
        'qnaTopics',
        'brandTheme',
        'updatedAt',
        'materialId',
        'description',
        'isDefault',
        'createdAt',
        'category'
      ]) &&
      (!('brandTheme' in data) || data.brandTheme is map) &&
      (!('materialId' in data) || (data.materialId is string && data.materialId.size() <= 100)) &&
      (!('description' in data) || (data.description is string && data.description.size() <= 300)) &&
      (!('category' in data) || (data.category is string && data.category.size() <= 60)) &&
      (!('isDefault' in data) || data.isDefault is bool) &&
      (!('createdAt' in data) || data.createdAt is int) &&
      data.seminarTitle is string && data.seminarTitle.size() >= 1 && data.seminarTitle.size() <= 120 &&
      data.organizerName is string && data.organizerName.size() >= 1 && data.organizerName.size() <= 100 &&
      data.questions is list && data.questions.size() >= 1 && data.questions.size() <= 25 &&
      data.polls is list && data.polls.size() >= 1 && data.polls.size() <= 15 &&
      data.slides is list && data.slides.size() >= 1 && data.slides.size() <= 40 &&
      data.qnaTopics is list && data.qnaTopics.size() >= 1 && data.qnaTopics.size() <= 15 &&
      data.qnaTopics[0] is string &&
      data.updatedAt is int;
    }

    function isValidAnswer(data) {
      return data.keys().hasAll([
        'q',
        'text',
        'subText',
        'businessName',
        'participantId',
        'status',
        'star',
        'likes',
        'mentorNote',
        'ts'
      ]) &&
      data.keys().hasOnly([
        'q',
        'text',
        'subText',
        'businessName',
        'participantId',
        'status',
        'star',
        'spotlightSize',
        'likes',
        'mentorNote',
        'ts'
      ]) &&
      data.q is int && data.q >= 0 && data.q <= 30 &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 250 &&
      data.subText is string && data.subText.size() <= 200 &&
      data.businessName is string && data.businessName.size() <= 60 &&
      data.participantId is string && data.participantId.size() >= 1 && data.participantId.size() <= 64 && data.participantId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.status is string && data.status in ['pending', 'approved', 'hidden'] &&
      data.star is bool &&
      (!('spotlightSize' in data) || (data.spotlightSize is string && data.spotlightSize in ['besar', 'kecil'])) &&
      data.likes is int && data.likes >= 0 && data.likes <= 100000 &&
      data.mentorNote is string && data.mentorNote.size() <= 200 &&
      data.ts is int;
    }

    function isValidQnaItem(data) {
      return data.keys().hasAll([
        'text',
        'authorName',
        'isAnonymous',
        'topicTag',
        'upvotes',
        'status',
        'star',
        'participantId',
        'ts'
      ]) &&
      data.keys().hasOnly([
        'text',
        'authorName',
        'isAnonymous',
        'topicTag',
        'upvotes',
        'status',
        'star',
        'participantId',
        'ts'
      ]) &&
      data.text is string && data.text.size() >= 1 && data.text.size() <= 250 &&
      data.authorName is string && data.authorName.size() <= 60 &&
      data.isAnonymous is bool &&
      data.topicTag is string && data.topicTag.size() <= 40 &&
      data.upvotes is int && data.upvotes >= 0 && data.upvotes <= 100000 &&
      data.status is string && data.status in ['pending', 'approved', 'hidden', 'answered'] &&
      data.star is bool &&
      data.participantId is string && data.participantId.size() >= 1 && data.participantId.size() <= 64 && data.participantId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ts is int;
    }

    function isValidPollVote(data) {
      return data.keys().hasAll([
        'pollId',
        'optionId',
        'customWord',
        'businessName',
        'participantId',
        'ts'
      ]) &&
      data.keys().hasOnly([
        'pollId',
        'optionId',
        'customWord',
        'businessName',
        'participantId',
        'ts'
      ]) &&
      data.pollId is string && data.pollId.size() >= 1 && data.pollId.size() <= 64 && data.pollId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.optionId is string && data.optionId.size() >= 1 && data.optionId.size() <= 64 &&
      data.customWord is string && data.customWord.size() <= 40 &&
      data.businessName is string && data.businessName.size() <= 60 &&
      data.participantId is string && data.participantId.size() >= 1 && data.participantId.size() <= 64 && data.participantId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.ts is int;
    }

    function isValidFlipchartBoard(data) {
      return data.keys().hasAll([
        'isOpen',
        'syncToProjector',
        'activePageIndex',
        'pagesJson',
        'sourceDeviceId',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'isOpen',
        'syncToProjector',
        'activePageIndex',
        'pagesJson',
        'sourceDeviceId',
        'updatedAt'
      ]) &&
      data.isOpen is bool &&
      data.syncToProjector is bool &&
      data.activePageIndex is int && data.activePageIndex >= 0 && data.activePageIndex <= 25 &&
      data.pagesJson is string && data.pagesJson.size() >= 2 && data.pagesJson.size() <= 450000 &&
      data.sourceDeviceId is string && data.sourceDeviceId.size() >= 1 && data.sourceDeviceId.size() <= 64 && data.sourceDeviceId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.updatedAt is int;
    }

    function isValidUnlockCampaign(data) {
      return data.keys().hasAll([
        'title',
        'subtitle',
        'organizerName',
        'minQuota',
        'status',
        'deadlineLabel',
        'candidateMaterialIds',
        'timeSlots',
        'winningMaterialId',
        'winningSlotId',
        'confirmedScheduleNote',
        'updatedAt'
      ]) &&
      data.keys().hasOnly([
        'title',
        'subtitle',
        'organizerName',
        'minQuota',
        'status',
        'deadlineLabel',
        'candidateMaterialIds',
        'timeSlots',
        'winningMaterialId',
        'winningSlotId',
        'confirmedScheduleNote',
        'materialPricing',
        'qrisPayload',
        'qrisMerchantName',
        'qrisMerchantNmid',
        'qrisFallbackImageUrl',
        'mentorWhatsapp',
        'updatedAt'
      ]) &&
      data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
      data.subtitle is string && data.subtitle.size() <= 300 &&
      data.organizerName is string && data.organizerName.size() >= 1 && data.organizerName.size() <= 100 &&
      data.minQuota is int && data.minQuota >= 5 && data.minQuota <= 200 &&
      data.status is string && data.status in ['open', 'unlocked', 'scheduled', 'closed'] &&
      data.deadlineLabel is string && data.deadlineLabel.size() <= 80 &&
      data.candidateMaterialIds is list && data.candidateMaterialIds.size() >= 1 && data.candidateMaterialIds.size() <= 20 &&
      data.candidateMaterialIds[0] is string &&
      data.timeSlots is list && data.timeSlots.size() >= 1 && data.timeSlots.size() <= 8 &&
      data.timeSlots[0] is map &&
      data.winningMaterialId is string && data.winningMaterialId.size() <= 100 &&
      data.winningSlotId is string && data.winningSlotId.size() <= 64 &&
      data.confirmedScheduleNote is string && data.confirmedScheduleNote.size() <= 250 &&
      (!('materialPricing' in data) || (data.materialPricing is map && data.materialPricing.size() <= 50)) &&
      (!('qrisPayload' in data) || (data.qrisPayload is string && data.qrisPayload.size() <= 600)) &&
      (!('qrisMerchantName' in data) || (data.qrisMerchantName is string && data.qrisMerchantName.size() <= 100)) &&
      (!('qrisMerchantNmid' in data) || (data.qrisMerchantNmid is string && data.qrisMerchantNmid.size() <= 40)) &&
      (!('qrisFallbackImageUrl' in data) || (data.qrisFallbackImageUrl is string && data.qrisFallbackImageUrl.size() <= 300)) &&
      (!('mentorWhatsapp' in data) || (data.mentorWhatsapp is string && data.mentorWhatsapp.size() <= 24)) &&
      data.updatedAt is int;
    }

    function isValidUnlockVote(data) {
      return data.keys().hasAll([
        'campaignId',
        'participantId',
        'displayName',
        'businessName',
        'primaryMaterialId',
        'secondaryMaterialIds',
        'availableSlotIds',
        'flexibleTopic',
        'mainChallenge',
        'status',
        'ts'
      ]) &&
      data.keys().hasOnly([
        'campaignId',
        'participantId',
        'displayName',
        'businessName',
        'primaryMaterialId',
        'secondaryMaterialIds',
        'availableSlotIds',
        'flexibleTopic',
        'mainChallenge',
        'status',
        'paymentStatus',
        'paymentUniqueCode',
        'paymentAmount',
        'ts'
      ]) &&
      data.campaignId is string && data.campaignId.size() >= 1 && data.campaignId.size() <= 64 && data.campaignId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.participantId is string && data.participantId.size() >= 1 && data.participantId.size() <= 64 && data.participantId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
      data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 60 &&
      data.primaryMaterialId is string && data.primaryMaterialId.size() >= 1 && data.primaryMaterialId.size() <= 100 &&
      data.secondaryMaterialIds is list && data.secondaryMaterialIds.size() <= 3 &&
      (data.secondaryMaterialIds.size() == 0 || data.secondaryMaterialIds[0] is string) &&
      data.availableSlotIds is list && data.availableSlotIds.size() >= 1 && data.availableSlotIds.size() <= 8 &&
      data.availableSlotIds[0] is string &&
      data.flexibleTopic is bool &&
      data.mainChallenge is string && data.mainChallenge.size() <= 220 &&
      data.status is string && data.status in ['committed', 'confirmed_h1', 'cancelled'] &&
      (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus in ['free', 'unpaid', 'confirming', 'paid'])) &&
      (!('paymentUniqueCode' in data) || (data.paymentUniqueCode is int && data.paymentUniqueCode >= 0 && data.paymentUniqueCode <= 999)) &&
      (!('paymentAmount' in data) || (data.paymentAmount is int && data.paymentAmount >= 0 && data.paymentAmount <= 50000000)) &&
      data.ts is int;
    }

    function isValidUnlockContact(data) {
      return data.keys().hasAll([
        'campaignId',
        'voteId',
        'participantId',
        'displayName',
        'businessName',
        'whatsapp',
        'ts'
      ]) &&
      data.keys().hasOnly([
        'campaignId',
        'voteId',
        'participantId',
        'displayName',
        'businessName',
        'whatsapp',
        'instagram',
        'businessCategory',
        'interestedTopicId',
        'interestedTopicTitle',
        'leadStage',
        'mentorNotes',
        'paymentStatus',
        'paymentUniqueCode',
        'paymentAmount',
        'paidAt',
        'ts'
      ]) &&
      data.campaignId is string && data.campaignId.size() >= 1 && data.campaignId.size() <= 64 && data.campaignId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.voteId is string && data.voteId.size() >= 1 && data.voteId.size() <= 128 && data.voteId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.participantId is string && data.participantId.size() >= 1 && data.participantId.size() <= 64 && data.participantId.matches('^[a-zA-Z0-9_\\-]+$') &&
      data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
      data.businessName is string && data.businessName.size() >= 1 && data.businessName.size() <= 60 &&
      data.whatsapp is string && data.whatsapp.size() >= 6 && data.whatsapp.size() <= 24 &&
      (!('instagram' in data) || (data.instagram is string && data.instagram.size() <= 64)) &&
      (!('businessCategory' in data) || (data.businessCategory is string && data.businessCategory.size() <= 40)) &&
      (!('interestedTopicId' in data) || (data.interestedTopicId is string && data.interestedTopicId.size() <= 100)) &&
      (!('interestedTopicTitle' in data) || (data.interestedTopicTitle is string && data.interestedTopicTitle.size() <= 120)) &&
      (!('leadStage' in data) || (data.leadStage is string && data.leadStage in ['lead_baru', 'sudah_dihubungi', 'hadir_kelas', 'prospek_klien', 'klien_deal'])) &&
      (!('mentorNotes' in data) || (data.mentorNotes is string && data.mentorNotes.size() <= 300)) &&
      (!('paymentStatus' in data) || (data.paymentStatus is string && data.paymentStatus in ['free', 'unpaid', 'confirming', 'paid'])) &&
      (!('paymentUniqueCode' in data) || (data.paymentUniqueCode is int && data.paymentUniqueCode >= 0 && data.paymentUniqueCode <= 999)) &&
      (!('paymentAmount' in data) || (data.paymentAmount is int && data.paymentAmount >= 0 && data.paymentAmount <= 50000000)) &&
      (!('paidAt' in data) || data.paidAt is int) &&
      data.ts is int;
    }

    // Connection test path
    match /test/{docId} {
      allow get: if isValidId(docId);
    }

    // Session state
    match /state/{sessionId} {
      allow get: if isValidId(sessionId);
      allow list: if resource.data.updatedAt is int || true;
      allow create: if isValidId(sessionId) && isValidSessionState(incoming());
      allow update: if isValidId(sessionId) && isValidSessionState(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'activeQuestion',
          'activeSlide',
          'activeSlideStep',
          'stepByStepEnabled',
          'transitionStyle',
          'activeSlideDrawer',
          'allowParticipantSlideAccess',
          'answersLocked',
          'lockedNotice',
          'activeMode',
          'activePollId',
          'moderationEnabled',
          'externalEmbedUrl',
          'externalPlatform',
          'sessionName',
          'updatedAt'
        ])
      );
    }

    // Custom seminar content
    match /custom_content/{docId} {
      allow get: if isValidId(docId);
      allow list: if resource.data.updatedAt is int || true;
      allow create: if isValidId(docId) && isValidCustomContent(incoming());
      allow update: if isValidId(docId) && isValidCustomContent(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'seminarTitle',
          'organizerName',
          'questions',
          'polls',
          'slides',
          'qnaTopics',
          'brandTheme',
          'updatedAt',
          'materialId',
          'description',
          'isDefault',
          'createdAt',
          'category'
        ])
      );
      allow delete: if isValidId(docId);
    }

    // Worksheet Answers: allow real-time collection query for projector & participants
    match /answers/{answerId} {
      allow get: if isValidId(answerId);
      allow list: if resource.data.ts is int || true;
      allow create: if isValidId(answerId) && isValidAnswer(incoming());
      allow update: if isValidId(answerId) && isValidAnswer(incoming()) && (
        isAdmin() ||
        (incoming().q == existing().q &&
         incoming().participantId == existing().participantId &&
         incoming().ts == existing().ts &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'star', 'likes', 'text', 'subText', 'businessName', 'mentorNote']))
      );
      allow delete: if isValidId(answerId);
    }

    // Live Q&A
    match /qna/{questionId} {
      allow get: if isValidId(questionId);
      allow list: if resource.data.ts is int || true;
      allow create: if isValidId(questionId) && isValidQnaItem(incoming());
      allow update: if isValidId(questionId) && isValidQnaItem(incoming()) && (
        isAdmin() ||
        (incoming().participantId == existing().participantId &&
         incoming().ts == existing().ts &&
         incoming().diff(existing()).affectedKeys().hasOnly(['upvotes', 'status', 'star', 'text', 'authorName', 'topicTag']))
      );
      allow delete: if isValidId(questionId);
    }

    // Live Poll & Word Cloud Votes
    match /poll_votes/{voteId} {
      allow get: if isValidId(voteId);
      allow list: if resource.data.ts is int || true;
      allow create: if isValidId(voteId) && isValidPollVote(incoming());
      allow update: if isValidId(voteId) && isValidPollVote(incoming()) && (
        isAdmin() ||
        (incoming().participantId == existing().participantId &&
         incoming().pollId == existing().pollId &&
         incoming().diff(existing()).affectedKeys().hasOnly(['optionId', 'customWord', 'businessName', 'ts']))
      );
      allow delete: if isValidId(voteId);
    }

    // Live Flipchart / Whiteboard sync between presenter remote tablet & projector stage
    match /flipchart/{boardId} {
      allow get: if isValidId(boardId);
      allow list: if resource.data.updatedAt is int || true;
      allow create: if isValidId(boardId) && isValidFlipchartBoard(incoming());
      allow update: if isValidId(boardId) && isValidFlipchartBoard(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'isOpen',
          'syncToProjector',
          'activePageIndex',
          'pagesJson',
          'sourceDeviceId',
          'updatedAt'
        ])
      );
      allow delete: if isValidId(boardId);
    }

    // Class Unlock Voting Campaign Configuration
    match /unlock_campaigns/{campaignId} {
      allow get: if isValidId(campaignId);
      allow list: if resource.data.updatedAt is int;
      allow create: if isValidId(campaignId) && isValidUnlockCampaign(incoming());
      allow update: if isValidId(campaignId) && isValidUnlockCampaign(incoming()) && (
        isAdmin() ||
        incoming().diff(existing()).affectedKeys().hasOnly([
          'title',
          'subtitle',
          'organizerName',
          'minQuota',
          'status',
          'deadlineLabel',
          'candidateMaterialIds',
          'timeSlots',
          'winningMaterialId',
          'winningSlotId',
          'confirmedScheduleNote',
          'materialPricing',
          'qrisPayload',
          'qrisMerchantName',
          'qrisMerchantNmid',
          'qrisFallbackImageUrl',
          'mentorWhatsapp',
          'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Class Unlock Public Votes (Zero PII: no WhatsApp or email stored here)
    match /unlock_votes/{voteId} {
      allow get: if isValidId(voteId);
      allow list: if resource.data.campaignId is string && resource.data.ts is int;
      allow create: if isValidId(voteId) &&
        isValidUnlockVote(incoming()) &&
        (
          isAdmin() ||
          !('paymentStatus' in incoming()) ||
          incoming().paymentStatus in ['free', 'unpaid', 'confirming']
        );
      allow update: if isValidId(voteId) && isValidUnlockVote(incoming()) && (
        isAdmin() ||
        (
          incoming().campaignId == existing().campaignId &&
          incoming().participantId == existing().participantId &&
          (
            !('paymentStatus' in incoming()) ||
            incoming().paymentStatus in ['free', 'unpaid', 'confirming'] ||
            ('paymentStatus' in existing() && existing().paymentStatus == 'paid' && incoming().paymentStatus == 'paid')
          ) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'businessName',
            'primaryMaterialId',
            'secondaryMaterialIds',
            'availableSlotIds',
            'flexibleTopic',
            'mainChallenge',
            'status',
            'paymentStatus',
            'paymentUniqueCode',
            'paymentAmount',
            'ts'
          ])
        )
      );
      allow delete: if isValidId(voteId);
    }

    // Class Unlock Private Contacts & UMKM Lead Database (PII Isolated: WhatsApp & Instagram readable only by verified mentor admin)
    match /unlock_contacts/{contactId} {
      allow get, list: if isAdmin();
      allow create: if isValidId(contactId) &&
        isValidUnlockContact(incoming()) &&
        incoming().voteId == contactId &&
        existsAfter(/databases/$(database)/documents/unlock_votes/$(contactId)) &&
        (
          isAdmin() ||
          (
            (!('leadStage' in incoming()) || incoming().leadStage == 'lead_baru') &&
            (!('mentorNotes' in incoming()) || incoming().mentorNotes == '') &&
            (!('paymentStatus' in incoming()) || incoming().paymentStatus in ['free', 'unpaid', 'confirming']) &&
            !('paidAt' in incoming())
          )
        );
      allow update: if isValidId(contactId) && isValidUnlockContact(incoming()) && (
        isAdmin() ||
        (
          incoming().campaignId == existing().campaignId &&
          incoming().voteId == existing().voteId &&
          incoming().participantId == existing().participantId &&
          (
            !('paymentStatus' in incoming()) ||
            incoming().paymentStatus in ['free', 'unpaid', 'confirming'] ||
            ('paymentStatus' in existing() && existing().paymentStatus == 'paid' && incoming().paymentStatus == 'paid')
          ) &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'displayName',
            'businessName',
            'whatsapp',
            'instagram',
            'businessCategory',
            'interestedTopicId',
            'interestedTopicTitle',
            'paymentStatus',
            'paymentUniqueCode',
            'paymentAmount',
            'ts'
          ])
        )
      );
      allow delete: if isAdmin();
    }
  }
}
